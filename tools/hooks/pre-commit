#!/usr/bin/env bash
# ★★★ 2026-10-16 10:13: 【公开仓【的【守卫【也【要【拦住】**✓✓
#
# 为什么有它
#   这个仓的守卫是 tools/smoke.py：它一整套自检（数据库能连、能读到 bar、策略能跑）。
#   而我一直是手动跑它 —— 而今天已经证明「写在纸上/记在脑子里」不会自动生效。
#
# 范围
#   只跑 smoke。它需要 Windows python（连库），所以这条比旧仓那条慢几秒到几十秒；
#   但它拦的是「整个仓能不能启动」这种级别的问题，值这个时间。
#
# 绕过
#   git commit --no-verify
set -u
cd "$(git rev-parse --show-toplevel)" || exit 0
[ -f tools/smoke.py ] || exit 0
py=""
for c in python.exe python3.exe; do
  command -v "$c" >/dev/null 2>&1 && { py="$c"; break; }
done
if [ -z "$py" ]; then
  # ★ WSL 里没有 Windows python ⇒ 用 powershell 转一手 ✓
  out=$(powershell.exe -NoProfile -Command \
    "\$env:PYTHONIOENCODING='utf-8'; \$p=(Get-Command python -EA SilentlyContinue).Source; \
     Set-Location '$(pwd -W 2>/dev/null || pwd)'; & \$p tools\smoke.py 2>&1 | Select-Object -Last 4; \
     exit \$LASTEXITCODE" 2>&1)
  code=$?
else
  out=$("$py" tools/smoke.py 2>&1); code=$?
fi
if [ $code -ne 0 ]; then
  echo "[pre-commit] ✗ smoke exit=$code ⇒ 拒绝提交"
  echo "$out" | tail -6 | sed 's/^/    /'
  echo "[pre-commit] 确要绕过用 --no-verify。"
  exit 1
fi
echo "[pre-commit] ✓ smoke"

# ★★★ 2026-10-16 10:17: 【隐私守卫（★ 公开仓【才【是【别人【会【克【隆【的【那【个 ✓）】
#   · 【它【只【用 WSL python3、【秒级 ✓ ⇒ 【挂【在【每【次【提交【上【不【疼 ✓
# ★★★ 2026-10-16 11:20: 【文档结构检查（★ 围栏【配对 + 表格【被【打断）**【✓✓
#   · 【为什么【加它】: 【这个仓【有 24 个文档在 docs/ 下、【而【此【前【没【有【任【何【检查
#     【看【它【们【的【结构】✗ ⇒ 【**两份【坏【掉【的【文档、【读【者【会【看【到【错【误【的【渲【染 ✓
#   · ★ 【而【它【是【从【另【一【个仓【推【广【过【来【的】:
#     【那边【把 `docs/` 加【进【扫【描【后【立【刻【报【出 5 处 ⇒ 【**"【一个仓【里【的【覆盖【漏【洞、
#     【另【一【个仓【里【大【概【率【也【有"**】✓✓
#   · ★★ 【而【它【见【过【红】✓（★ 三种【样本: 表格【打断 ⇒ 1 · 围栏【奇数 ⇒ 1 · 干净 ⇒ 0 ✓）
#     ⇒ 【**所以【它【有【资【格【挂（★ 第 4.3 条 ✓）✓✓**
if [ -f tools/md_structure_check.py ]; then
  md_out=$(python3 tools/md_structure_check.py 2>&1); md_code=$?
  if [ $md_code -ne 0 ]; then
    echo "[pre-commit] ✗ md_structure_check exit=$md_code ⇒ 拒绝提交"
    echo "$md_out" | tail -4 | sed 's/^/    /'
    fail=1
  else
    echo "[pre-commit] ✓ md_structure_check"
  fi
fi

if [ -f tools/privacy_check.py ]; then
  pout=$(python3 tools/privacy_check.py 2>&1); pcode=$?
  if [ $pcode -ne 0 ]; then
    echo "[pre-commit] ✗ privacy_check exit=$pcode ⇒ 拒绝提交"
    echo "$pout" | tail -6 | sed 's/^/    /'
    exit 1
  fi
  echo "[pre-commit] ✓ privacy_check"
fi
exit 0
